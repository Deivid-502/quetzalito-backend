# ===== Server =====
NODE_ENV=development
PORT=3001
APP_NAME=Quetzalito
FRONTEND_URL=http://localhost:3000

# ===== Database =====
DATABASE_URL=postgresql://XXX:XXX@localhost:5432/XXXXX?schema=public

# ===== JWT =====
# Genera con: openssl rand -base64 64
JWT_ACCESS_SECRET=cambia-este-secreto-en-produccion-access-token-quetzalito
JWT_REFRESH_SECRET=cambia-este-secreto-en-produccion-refresh-token-quetzalito
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== Cookies =====
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false   # true en producción (HTTPS)

# ===== Rate limit =====
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===== Email / SMTP =====
# Dejar vacío para que los emails se impriman en consola (modo dev)
# En producción: configurar con tu proveedor SMTP (SendGrid, Brevo, SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Quetzalito <no-reply@quetzalito.com>
# Ejemplo con Mailtrap (dev con bandeja real):
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=tu_user_mailtrap
# SMTP_PASS=tu_pass_mailtrap
